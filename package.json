{
  "name": "browser-privacy-core",
  "version": "1.0.0",
  "description": "Two dependency-free privacy userscripts built from one auditable core.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test tests/core.test.mjs tests/build.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "check": "npm run build:check && npm test",
    "verify": "npm run check && npm run test:browser",
    "benchmark": "node scripts/benchmark.mjs",
    "demo": "node scripts/serve.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": { "playwright": "1.64.1" }
}
